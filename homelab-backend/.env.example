# Server
NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

# Database (LOCAL - Docker)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=homelab_dev

# Redis (LOCAL - Docker)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Obsidian — el vault vive en la raíz de este mismo repo (un nivel arriba de homelab-backend/)
OBSIDIAN_VAULT_PATH=..
OBSIDIAN_WATCH_ENABLED=false

# API
API_VERSION=v1
API_PREFIX=/api

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Mock Mode — mientras sea true, todos los endpoints sirven desde src/data/*.json
MOCK_MODE=true
MOCK_DATA_PATH=src/data/
